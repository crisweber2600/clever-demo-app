# Clever Demo App - Environment Configuration
# SSO-1: All secrets must be provided via environment variables

# Clever OAuth Configuration
CLEVER_CLIENT_ID=your_clever_client_id_here
CLEVER_CLIENT_SECRET=your_clever_client_secret_here
CLEVER_CALLBACK_URL=http://localhost:3000/auth/clever/callback

# Express Session
SESSION_SECRET=choose_a_random_secret_for_sessions

# Backend Integration (SSO-1)
UPGRADE_API_BASE_URL=http://localhost:5000
UPGRADE_API_CLIENT_ID=demo-app-integration-client
UPGRADE_API_CLIENT_SECRET=your_integration_secret_here
UPGRADE_API_TIMEOUT_MS=5000

# Notes:
# - Never commit this file with real secrets
# - For production: Use HTTPS URLs and strong secrets
# - See config.js for validation rules
